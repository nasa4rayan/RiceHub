{
  "name": "ricehub",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source platform for discovering, previewing, installing, and sharing Linux desktop themes",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:website": "cd website && npm run dev",
    "dev:cli": "cd cli && npm run dev"
  },
  "workspaces": [
    "website",
    "cli",
    "installer",
    "scripts"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
